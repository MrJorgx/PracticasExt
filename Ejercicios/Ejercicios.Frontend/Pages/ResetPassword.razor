@page "/reset-password"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<ResetPassword> Logger

<PageTitle>Restablecer Contraseña - Ejercicios</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>
                <i class="bi bi-shield-lock"></i>
                Restablecer Contraseña
            </h2>
            <p class="text-muted">
                Ingresa tu nueva contraseña
            </p>
        </div>

        <div class="auth-body">
            @if (!passwordReset)
            {
                <EditForm Model="resetPasswordRequest" OnValidSubmit="HandleResetPassword">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Nueva contraseña:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <InputText @bind-Value="resetPasswordRequest.NewPassword" 
                                      type="password" 
                                      class="form-control" 
                                      placeholder="Mínimo 6 caracteres" />
                        </div>
                        <ValidationMessage For="() => resetPasswordRequest.NewPassword" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Confirmar nueva contraseña:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                            <InputText @bind-Value="resetPasswordRequest.ConfirmNewPassword" 
                                      type="password" 
                                      class="form-control" 
                                      placeholder="Repite la contraseña" />
                        </div>
                        <ValidationMessage For="() => resetPasswordRequest.ConfirmNewPassword" />
                    </div>

                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show">
                            <i class="bi bi-@(esError ? "exclamation-triangle" : "check-circle")"></i>
                            @mensaje
                            <button type="button" class="btn-close" @onclick="@(() => mensaje = "")"></button>
                        </div>
                    }

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-check-circle"></i> Restablecer Contraseña
                        </button>
                    </div>

                    <div class="text-center">
                        <a href="/auth" class="btn btn-link">
                            <i class="bi bi-arrow-left"></i> Volver al login
                        </a>
                    </div>
                </EditForm>
            }
            else
            {
                <div class="alert alert-success">
                    <h5 class="alert-heading">
                        <i class="bi bi-check-circle"></i> ¡Contraseña restablecida!
                    </h5>
                    <p>Tu contraseña ha sido actualizada exitosamente.</p>
                    <p class="mb-0">Ya puedes iniciar sesión con tu nueva contraseña.</p>
                </div>

                <div class="d-grid gap-2 mt-3">
                    <a href="/auth" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right"></i> Ir al login
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
    }

    .auth-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        max-width: 500px;
        width: 100%;
        overflow: hidden;
    }

    .auth-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        text-align: center;
    }

    .auth-header h2 {
        margin: 0 0 10px 0;
        font-weight: 600;
    }

    .auth-body {
        padding: 30px;
    }

    .input-group-text {
        background: #f8f9fa;
        border-right: none;
    }

    .form-control {
        border-left: none;
    }

    .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #5568d3 0%, #654a91 100%);
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private ResetPasswordRequest resetPasswordRequest = new ResetPasswordRequest();
    private bool isProcessing = false;
    private bool passwordReset = false;
    private string mensaje = "";
    private bool esError = false;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Token) || string.IsNullOrEmpty(Email))
        {
            mensaje = "El enlace de recuperación no es válido o ha expirado.";
            esError = true;
            Logger.LogWarning("Intento de reseteo de contraseña con parámetros inválidos");
            return;
        }

        resetPasswordRequest.Token = Token;
        resetPasswordRequest.Email = Email;

        Logger.LogInformation("Página de reseteo de contraseña cargada para: {Email}", Email);
    }

    private async Task HandleResetPassword()
    {
        try
        {
            isProcessing = true;
            mensaje = "";
            esError = false;

            Logger.LogInformation("Restableciendo contraseña para: {Email}", resetPasswordRequest.Email);

            var (success, message) = await AuthService.ResetPasswordAsync(resetPasswordRequest);

            if (success)
            {
                passwordReset = true;
                Logger.LogInformation("Contraseña restablecida exitosamente para: {Email}", resetPasswordRequest.Email);
            }
            else
            {
                mensaje = message;
                esError = true;
                Logger.LogWarning("Error al restablecer contraseña: {Error}", message);
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            esError = true;
            Logger.LogError(ex, "Error durante restablecimiento de contraseña");
        }
        finally
        {
            isProcessing = false;
        }
    }
}