@page "/forgot-password"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<ForgotPassword> Logger

<PageTitle>Recuperar Contraseña - Ejercicios</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>
                <i class="bi bi-key"></i>
                ¿Olvidaste tu contraseña?
            </h2>
            <p class="text-muted">
                Ingresa tu email y te enviaremos instrucciones para recuperarla
            </p>
        </div>

        <div class="auth-body">
            @if (!emailSent)
            {
                <EditForm Model="forgotPasswordRequest" OnValidSubmit="HandleForgotPassword">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Email:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <InputText @bind-Value="forgotPasswordRequest.Email" 
                                      type="email" 
                                      class="form-control" 
                                      placeholder="tu@email.com" />
                        </div>
                        <ValidationMessage For="() => forgotPasswordRequest.Email" />
                    </div>

                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show">
                            <i class="bi bi-@(esError ? "exclamation-triangle" : "check-circle")"></i>
                            @mensaje
                            <button type="button" class="btn-close" @onclick="@(() => mensaje = "")"></button>
                        </div>
                    }

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-send"></i> Enviar instrucciones
                        </button>
                    </div>

                    <div class="text-center">
                        <a href="/auth" class="btn btn-link">
                            <i class="bi bi-arrow-left"></i> Volver al login
                        </a>
                    </div>
                </EditForm>
            }
            else
            {
                <div class="alert alert-success">
                    <h5 class="alert-heading">
                        <i class="bi bi-envelope-check"></i> ¡Email enviado!
                    </h5>
                    <p>Si existe una cuenta asociada a <strong>@forgotPasswordRequest.Email</strong>, recibirás un email con instrucciones para restablecer tu contraseña.</p>
                    <hr>
                    <p class="mb-0 small">
                        <strong>¿No ves el email?</strong> Revisa tu carpeta de spam o correo no deseado.
                    </p>
                </div>

                <div class="d-grid gap-2 mt-3">
                    <a href="/auth" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right"></i> Volver al login
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        padding: 20px;
    }

    .auth-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        max-width: 500px;
        width: 100%;
        overflow: hidden;
    }

    .auth-header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 30px;
        text-align: center;
    }

    .auth-header h2 {
        margin: 0 0 10px 0;
        font-weight: 600;
    }

    .auth-body {
        padding: 30px;
    }

    .input-group-text {
        background: #f8f9fa;
        border-right: none;
    }

    .form-control {
        border-left: none;
    }

    .form-control:focus {
        border-color: #f093fb;
        box-shadow: 0 0 0 0.2rem rgba(240, 147, 251, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        border: none;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #e082ea 0%, #e4465b 100%);
    }
</style>

@code {
    private ForgotPasswordRequest forgotPasswordRequest = new ForgotPasswordRequest();
    private bool isProcessing = false;
    private bool emailSent = false;
    private string mensaje = "";
    private bool esError = false;

    private async Task HandleForgotPassword()
    {
        try
        {
            isProcessing = true;
            mensaje = "";
            esError = false;

            Logger.LogInformation("Solicitud de recuperación de contraseña para: {Email}", forgotPasswordRequest.Email);

            var (success, message) = await AuthService.ForgotPasswordAsync(forgotPasswordRequest.Email);

            if (success)
            {
                emailSent = true;
                Logger.LogInformation("Email de recuperación enviado a: {Email}", forgotPasswordRequest.Email);
            }
            else
            {
                mensaje = message;
                esError = true;
                Logger.LogWarning("Error en recuperación de contraseña: {Error}", message);
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            esError = true;
            Logger.LogError(ex, "Error durante recuperación de contraseña");
        }
        finally
        {
            isProcessing = false;
        }
    }
}