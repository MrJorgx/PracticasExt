@page "/ejercicio4"
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Ejercicio 4 - CRUD clientes y recibos</PageTitle>

<h1>Gestión de clientes y recibos</h1>

<div class="container-fluid">
    <!-- Pestañas de navegación -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "clientes" ? "active" : "")"
                    @onclick="@(() => CambiarPestana("clientes"))"
                    type="button">
                <i class="bi bi-people"></i> Clientes
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "recibos" ? "active" : "")"
                    @onclick="@(() => CambiarPestana("recibos"))"
                    type="button">
                <i class="bi bi-receipt"></i> Recibos
            </button>
        </li>
    </ul>

    <!-- Contenido de las pestañas -->
    @if (activeTab == "clientes")
    { 
        <!-- PESTAÑA CLIENTES -->
        <div>
            
            <!-- Formulario de cliente -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5><i class="bi bi-person-plus"></i> @(clienteEditando != null ? "Editar cliente" : "Crear cliente")</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">DNI *</label>
                            <input type="text" 
                                   class="form-control @(errorDniCliente ? "is-invalid" : "")"
                                   @bind="dniCliente" 
                                   placeholder="12345678A"
                                   maxlength="9"
                                   disabled="@(clienteEditando != null)"
                                   @oninput="ValidarDniEnTiempoReal" />
                            @if (errorDniCliente)
                            {
                                <div class="invalid-feedback">
                                    @mensajeErrorDni
                                </div>
                            }
                            <small class="form-text text-muted">Formato: 8 dígitos + 1 letra (ej: 12345678A)</small>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Nombre *</label>
                            <input type="text" class="form-control @(errorNombreCliente ? "is-invalid" : "")" 
                                   @bind="nombreCliente" placeholder="Juan" maxlength="100" />
                            @if (errorNombreCliente)
                            {
                                <div class="invalid-feedback">El nombre es obligatorio</div>
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Apellidos *</label>
                            <input type="text" class="form-control @(errorApellidosCliente ? "is-invalid" : "")" 
                                   @bind="apellidosCliente" placeholder="García López" maxlength="100" />
                            @if (errorApellidosCliente)
                            {
                                <div class="invalid-feedback">Los apellidos son obligatorios</div>
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Tipo de cliente *</label>
                            <select class="form-control @(errorTipoCliente ? "is-invalid" : "")" 
                                    @bind="tipoClienteSeleccionado" @bind:after="OnTipoClienteChanged">
                                <option value="">Seleccionar...</option>
                                <option value="REGISTRADO">REGISTRADO</option>
                                <option value="SOCIO">SOCIO</option>
                            </select>
                            @if (errorTipoCliente)
                            {
                                <div class="invalid-feedback">Debe seleccionar un tipo de cliente</div>
                            }
                        </div>
                    </div>
                    
                    <!-- Campo cuota máxima (solo para REGISTRADO) -->
                    @if (tipoClienteSeleccionado == "REGISTRADO")
                    {
                        <div class="row mt-3">
                            <div class="col-md-3">
                                <label class="form-label">Cuota Máxima * (€)</label>
                                <input type="text" class="form-control @(errorCuotaMaxima ? "is-invalid" : "")" 
                                       @bind="cuotaMaximaTexto" placeholder="100.50" />
                                @if (errorCuotaMaxima)
                                {
                                    <div class="invalid-feedback">
                                        @mensajeErrorCuota
                                    </div>
                                }
                                <small class="form-text text-muted">Los clientes REGISTRADO requieren cuota máxima</small>
                            </div>
                        </div>
                    }
                    
                    <div class="row mt-3">
                        <div class="col-12">
                            <button class="btn btn-primary me-2" @onclick="GuardarCliente" disabled="@isProcessingCliente">
                                @if (isProcessingCliente)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                <i class="bi bi-@(clienteEditando != null ? "pencil" : "plus-circle")"></i>
                                @(clienteEditando != null ? "Actualizar" : "Crear") Cliente
                            </button>
                            @if (clienteEditando != null)
                            {
                                <button class="btn btn-secondary me-2" @onclick="CancelarEdicionCliente">
                                    <i class="bi bi-x-circle"></i> Cancelar
                                </button>
                            }
                            <button class="btn btn-outline-secondary" @onclick="LimpiarFormularioCliente">
                                <i class="bi bi-trash"></i> Limpiar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Buscador de clientes -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5><i class="bi bi-search"></i> Buscar cliente por DNI</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label">DNI del cliente</label>
                            <input type="text" 
                                   class="form-control @(errorDniBusqueda ? "is-invalid" : "")" 
                                   @bind="dniBusqueda" 
                                   placeholder="12345678A"
                                   maxlength="9" />
                            @if (errorDniBusqueda)
                            {
                                <div class="invalid-feedback">
                                    @mensajeErrorDniBusqueda
                                </div>
                            }
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button class="btn btn-info me-2" @onclick="BuscarClientePorDni" disabled="@isProcessingBusqueda">
                                @if (isProcessingBusqueda)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                <i class="bi bi-search"></i> Buscar
                            </button>
                            <button class="btn btn-success me-2" @onclick="CargarTodosLosClientes" disabled="@isProcessingListado">
                                @if (isProcessingListado)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                <i class="bi bi-list"></i> Listar todos
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mensajes de error/éxito para clientes -->
            @if (!string.IsNullOrEmpty(mensajeCliente))
            {
                <div class="alert @(esErrorCliente ? "alert-danger" : "alert-success")" role="alert">
                    <i class="bi bi-@(esErrorCliente ? "exclamation-triangle" : "check-circle")"></i> @mensajeCliente
                </div>
            }

            <!-- Listado de clientes -->
            @if (clientes.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-list"></i> Lista de clientes (@clientes.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>DNI</th>
                                        <th>Nombre Completo</th>
                                        <th>Tipo</th>
                                        <th class="text-end">Cuota máx.</th>
                                        <th class="text-center">Recibos</th>
                                        <th class="text-center">Fecha alta</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cliente in clientes)
                                    {
                                        <tr>
                                            <td><strong>@cliente.Dni</strong></td>
                                            <td>@cliente.Nombre @cliente.Apellidos</td>
                                            <td>
                                                <span class="badge bg-@(cliente.TipoCliente == "SOCIO" ? "success" : "primary")">
                                                    @cliente.TipoCliente
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                @if (cliente.CuotaMaxima.HasValue)
                                                {
                                                    <text>@cliente.CuotaMaxima.Value.ToString("C2")</text>
                                                }
                                                else
                                                {
                                                    <text>-</text>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-info">@cliente.TotalRecibos</span>
                                            </td>
                                            <td class="text-center">@cliente.FechaAlta.ToString("dd/MM/yyyy")</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-outline-primary" 
                                                            @onclick="() => EditarCliente(cliente)"
                                                            title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" 
                                                            @onclick="() => EliminarCliente(cliente.Dni)"
                                                            title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-info" 
                                                            @onclick="() => VerRecibosCliente(cliente.Dni)"
                                                            title="Ver Recibos">
                                                        <i class="bi bi-receipt"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (activeTab == "recibos")
    {
        <!-- PESTAÑA RECIBOS -->
        <div>
            
            <!-- Formulario de recibo -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5><i class="bi bi-receipt"></i> @(reciboEditando != null ? "Editar recibo" : "Crear recibo")</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label">Número de Recibo *</label>
                            <input type="text" 
                                   class="form-control @(errorNumeroRecibo ? "is-invalid" : "")"
                                   @bind="numeroRecibo" 
                                   placeholder="REC-001"
                                   disabled="@(reciboEditando != null)"
                                   maxlength="50" />
                            @if (errorNumeroRecibo)
                            {
                                <div class="invalid-feedback">El número de recibo es obligatorio</div>
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">DNI del Cliente *</label>
                            <input type="text" 
                                   class="form-control @(errorDniRecibo ? "is-invalid" : "")"
                                   @bind="dniClienteRecibo" 
                                   placeholder="12345678A"
                                   maxlength="9"
                                   disabled="@(reciboEditando != null)" />
                            @if (errorDniRecibo)
                            {
                                <div class="invalid-feedback">
                                    @mensajeErrorDniRecibo
                                </div>
                            }
                            <small class="form-text text-muted">Formato: 8 dígitos + 1 letra</small>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Importe * (€)</label>
                            <input type="text" 
                                   class="form-control @(errorImporteRecibo ? "is-invalid" : "")"
                                   @bind="importeReciboTexto" 
                                   placeholder="50.75" />
                            @if (errorImporteRecibo)
                            {
                                <div class="invalid-feedback">
                                    @mensajeErrorImporte
                                </div>
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Emisión</label>
                            <input type="date" class="form-control" @bind="fechaEmision" />
                            <small class="form-text text-muted">Por defecto: fecha actual</small>
                        </div>
                    </div>
                    
                    <div class="row mt-3">
                        <div class="col-12">
                            <button class="btn btn-primary me-2" @onclick="GuardarRecibo" disabled="@isProcessingRecibo">
                                @if (isProcessingRecibo)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                <i class="bi bi-@(reciboEditando != null ? "pencil" : "plus-circle")"></i>
                                @(reciboEditando != null ? "Actualizar" : "Crear") Recibo
                            </button>
                            @if (reciboEditando != null)
                            {
                                <button class="btn btn-secondary me-2" @onclick="CancelarEdicionRecibo">
                                    <i class="bi bi-x-circle"></i> Cancelar
                                </button>
                            }
                            <button class="btn btn-outline-secondary" @onclick="LimpiarFormularioRecibo">
                                <i class="bi bi-trash"></i> Limpiar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Buscador de recibos por cliente -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5><i class="bi bi-search"></i> Buscar recibos por cliente</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label">DNI del cliente</label>
                            <input type="text" 
                                   class="form-control @(errorDniBusquedaRecibo ? "is-invalid" : "")" 
                                   @bind="dniBusquedaRecibo" 
                                   placeholder="12345678A"
                                   maxlength="9" />
                            @if (errorDniBusquedaRecibo)
                            {
                                <div class="invalid-feedback">
                                    @mensajeErrorDniBusquedaRecibo
                                </div>
                            }
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button class="btn btn-info me-2" @onclick="BuscarRecibosPorCliente" disabled="@isProcessingBusquedaRecibo">
                                @if (isProcessingBusquedaRecibo)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                <i class="bi bi-search"></i> Buscar recibos
                            </button>
                            <button class="btn btn-success" @onclick="CargarTodosLosRecibos" disabled="@isProcessingListadoRecibo">
                                @if (isProcessingListadoRecibo)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                <i class="bi bi-list"></i> Listar todos
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mensajes de error/éxito para recibos -->
            @if (!string.IsNullOrEmpty(mensajeRecibo))
            {
                <div class="alert @(esErrorRecibo ? "alert-danger" : "alert-success")" role="alert">
                    <i class="bi bi-@(esErrorRecibo ? "exclamation-triangle" : "check-circle")"></i> @mensajeRecibo
                </div>
            }

            <!-- Listado de recibos -->
            @if (recibos.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-list"></i> Lista de recibos (@recibos.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Número</th>
                                        <th>DNI cliente</th>
                                        <th>Nombre cliente</th>
                                        <th class="text-end">Importe</th>
                                        <th class="text-center">Fecha emisión</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var recibo in recibos)
                                    {
                                        <tr>
                                            <td><strong>@recibo.NumeroRecibo</strong></td>
                                            <td>@recibo.DniCliente</td>
                                            <td>@recibo.NombreCliente</td>
                                            <td class="text-end">@recibo.Importe.ToString("C2")</td>
                                            <td class="text-center">@recibo.FechaEmision.ToString("dd/MM/yyyy")</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-outline-primary" 
                                                            @onclick="() => EditarRecibo(recibo)"
                                                            title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" 
                                                            @onclick="() => EliminarRecibo(recibo.NumeroRecibo)"
                                                            title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    // ===== VARIABLE PARA PESTAÑA =====
    private string activeTab = "clientes";

    // ===== VARIABLES DE ESTADO =====
    
    // Estados de procesamiento
    private bool isProcessingCliente = false;
    private bool isProcessingRecibo = false;
    private bool isProcessingBusqueda = false;
    private bool isProcessingBusquedaRecibo = false;
    private bool isProcessingListado = false;
    private bool isProcessingListadoRecibo = false;

    // Estados de error por campo - CLIENTES
    private bool errorDniCliente = false;
    private bool errorNombreCliente = false;
    private bool errorApellidosCliente = false;
    private bool errorTipoCliente = false;
    private bool errorCuotaMaxima = false;
    private bool errorDniBusqueda = false;
    
    // Estados de error por campo - RECIBOS
    private bool errorNumeroRecibo = false;
    private bool errorDniRecibo = false;
    private bool errorImporteRecibo = false;
    private bool errorDniBusquedaRecibo = false;

    // Mensajes de error específicos
    private string mensajeErrorDni = "";
    private string mensajeErrorCuota = "";
    private string mensajeErrorDniBusqueda = "";
    private string mensajeErrorDniRecibo = "";
    private string mensajeErrorImporte = "";
    private string mensajeErrorDniBusquedaRecibo = "";

    // Variables del formulario de CLIENTES
    private string dniCliente = "";
    private string nombreCliente = "";
    private string apellidosCliente = "";
    private string tipoClienteSeleccionado = "";
    private string cuotaMaximaTexto = "";
    private string dniBusqueda = "";

    // Variables del formulario de RECIBOS
    private string numeroRecibo = "";
    private string dniClienteRecibo = "";
    private string importeReciboTexto = "";
    private DateTime fechaEmision = DateTime.Today;
    private string dniBusquedaRecibo = "";

    // Variables de mensaje
    private string mensajeCliente = "";
    private string mensajeRecibo = "";
    private bool esErrorCliente = false;
    private bool esErrorRecibo = false;

    // Listas y objetos de edición
    private List<ClienteResponse> clientes = new List<ClienteResponse>();
    private List<ReciboResponse> recibos = new List<ReciboResponse>();
    private ClienteResponse? clienteEditando = null;
    private ReciboResponse? reciboEditando = null;

    // ===== MÉTODOS DE VALIDACIÓN DNI =====
    
    private bool ValidarFormatoDni(string dni)
    {
        if (string.IsNullOrWhiteSpace(dni))
            return false;
        
        dni = dni.Trim().ToUpper();
        
        // Patrón: exactamente 8 dígitos seguidos de 1 letra
        return System.Text.RegularExpressions.Regex.IsMatch(dni, @"^[0-9]{8}[A-Z]$");
    }
    
    private void ValidarDniEnTiempoReal(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString()?.ToUpper() ?? "";
        dniCliente = valor;
        
        if (string.IsNullOrWhiteSpace(valor))
        {
            errorDniCliente = false;
            mensajeErrorDni = "";
            return;
        }
        
        if (!ValidarFormatoDni(valor))
        {
            errorDniCliente = true;
            if (valor.Length < 9)
            {
                mensajeErrorDni = "DNI incompleto. Debe tener 8 dígitos + 1 letra";
            }
            else if (valor.Length > 9)
            {
                mensajeErrorDni = "DNI demasiado largo. Máximo 8 dígitos + 1 letra";
            }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(valor.Substring(0, 8), @"^[0-9]+$"))
            {
                mensajeErrorDni = "Los primeros 8 caracteres deben ser números";
            }
            else if (!System.Text.RegularExpressions.Regex.IsMatch(valor.Substring(8, 1), @"^[A-Z]$"))
            {
                mensajeErrorDni = "El último carácter debe ser una letra";
            }
            else
            {
                mensajeErrorDni = "Formato de DNI inválido (ej: 12345678A)";
            }
        }
        else
        {
            errorDniCliente = false;
            mensajeErrorDni = "";
        }
    }

    // ===== MÉTODOS DE GESTIÓN DE CLIENTES =====
    
    private async Task GuardarCliente()
    {
        try
        {
            isProcessingCliente = true;
            LimpiarErroresCliente();
            mensajeCliente = "";

            // Validar campos obligatorios
            var hayErrores = false;

            // Validar DNI
            if (string.IsNullOrWhiteSpace(dniCliente))
            {
                errorDniCliente = true;
                mensajeErrorDni = "El DNI es obligatorio";
                hayErrores = true;
            }
            else if (!ValidarFormatoDni(dniCliente))
            {
                errorDniCliente = true;
                mensajeErrorDni = "El DNI debe tener exactamente 8 dígitos seguidos de una letra (ej: 12345678A)";
                hayErrores = true;
            }

            // Validar nombre
            if (string.IsNullOrWhiteSpace(nombreCliente))
            {
                errorNombreCliente = true;
                hayErrores = true;
            }

            // Validar apellidos
            if (string.IsNullOrWhiteSpace(apellidosCliente))
            {
                errorApellidosCliente = true;
                hayErrores = true;
            }

            // Validar tipo de cliente
            if (string.IsNullOrWhiteSpace(tipoClienteSeleccionado))
            {
                errorTipoCliente = true;
                hayErrores = true;
            }

            // Validar cuota máxima para clientes REGISTRADO
            decimal? cuotaMaxima = null;
            if (tipoClienteSeleccionado == "REGISTRADO")
            {
                if (string.IsNullOrWhiteSpace(cuotaMaximaTexto))
                {
                    errorCuotaMaxima = true;
                    mensajeErrorCuota = "Los clientes REGISTRADO deben tener una cuota máxima";
                    hayErrores = true;
                }
                else if (!decimal.TryParse(cuotaMaximaTexto.Trim(), out decimal cuota) || cuota <= 0)
                {
                    errorCuotaMaxima = true;
                    mensajeErrorCuota = "La cuota máxima debe ser un número mayor que 0";
                    hayErrores = true;
                }
                else
                {
                    cuotaMaxima = cuota;
                }
            }
            else if (tipoClienteSeleccionado == "SOCIO")
            {
                if (!string.IsNullOrWhiteSpace(cuotaMaximaTexto))
                {
                    errorCuotaMaxima = true;
                    mensajeErrorCuota = "Los clientes SOCIO no deben tener cuota máxima";
                    hayErrores = true;
                }
            }

            if (hayErrores)
            {
                mensajeCliente = "Corrija los errores en el formulario";
                esErrorCliente = true;
                return;
            }

            // Normalizar DNI
            var dniNormalizado = dniCliente.Trim().ToUpper();

            if (clienteEditando == null)
            {
                // Crear nuevo cliente
                var request = new ClienteRequest
                {
                    Dni = dniNormalizado,
                    Nombre = nombreCliente.Trim(),
                    Apellidos = apellidosCliente.Trim(),
                    TipoCliente = tipoClienteSeleccionado,
                    CuotaMaxima = cuotaMaxima
                };

                var response = await Http.PostAsJsonAsync("api/cliente", request);
                
                if (response.IsSuccessStatusCode)
                {
                    var clienteCreado = await response.Content.ReadFromJsonAsync<ClienteResponse>();
                    mensajeCliente = $"Cliente {clienteCreado!.Dni} creado correctamente";
                    esErrorCliente = false;
                    LimpiarFormularioCliente();
                    await CargarTodosLosClientes();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    mensajeCliente = $"Error al crear cliente: {error}";
                    esErrorCliente = true;
                }
            }
            else
            {
                // Actualizar cliente existente
                var request = new ClienteUpdateRequest
                {
                    Nombre = nombreCliente.Trim(),
                    Apellidos = apellidosCliente.Trim(),
                    TipoCliente = tipoClienteSeleccionado,
                    CuotaMaxima = cuotaMaxima
                };

                var response = await Http.PutAsJsonAsync($"api/cliente/{clienteEditando.Dni}", request);
                
                if (response.IsSuccessStatusCode)
                {
                    mensajeCliente = $"Cliente {clienteEditando.Dni} actualizado correctamente";
                    esErrorCliente = false;
                    clienteEditando = null;
                    LimpiarFormularioCliente();
                    await CargarTodosLosClientes();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    mensajeCliente = $"Error al actualizar cliente: {error}";
                    esErrorCliente = true;
                }
            }
        }
        catch (Exception ex)
        {
            mensajeCliente = $"Error de conexión: {ex.Message}";
            esErrorCliente = true;
        }
        finally
        {
            isProcessingCliente = false;
        }
    }

    private async Task BuscarClientePorDni()
    {
        try
        {
            isProcessingBusqueda = true;
            mensajeCliente = "";
            errorDniBusqueda = false;
            mensajeErrorDniBusqueda = "";

            if (string.IsNullOrWhiteSpace(dniBusqueda))
            {
                errorDniBusqueda = true;
                mensajeErrorDniBusqueda = "Introduzca el DNI a buscar";
                return;
            }

            var dniNormalizado = dniBusqueda.Trim().ToUpper();
            
            if (!ValidarFormatoDni(dniNormalizado))
            {
                errorDniBusqueda = true;
                mensajeErrorDniBusqueda = "El DNI debe tener exactamente 8 dígitos seguidos de una letra (ej: 12345678A)";
                return;
            }

            var response = await Http.GetAsync($"api/cliente/{dniNormalizado}");
            
            if (response.IsSuccessStatusCode)
            {
                var cliente = await response.Content.ReadFromJsonAsync<ClienteResponse>();
                clientes.Clear();
                clientes.Add(cliente!);
                mensajeCliente = $"Cliente encontrado: {cliente!.Nombre} {cliente.Apellidos}";
                esErrorCliente = false;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                clientes.Clear();
                mensajeCliente = $"No se encontró ningún cliente con DNI {dniNormalizado}";
                esErrorCliente = true;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensajeCliente = $"Error al buscar cliente: {error}";
                esErrorCliente = true;
            }
        }
        catch (Exception ex)
        {
            mensajeCliente = $"Error de conexión: {ex.Message}";
            esErrorCliente = true;
        }
        finally
        {
            isProcessingBusqueda = false;
        }
    }

