    private void EditarCliente(ClienteResponse cliente)
    {
        clienteEditando = cliente;
        dniCliente = cliente.Dni;
        nombreCliente = cliente.Nombre;
        apellidosCliente = cliente.Apellidos;
        tipoClienteSeleccionado = cliente.TipoCliente;
        cuotaMaximaTexto = cliente.CuotaMaxima?.ToString() ?? "";
        
        LimpiarErroresCliente();
        mensajeCliente = $"Editando cliente {cliente.Dni}";
        esErrorCliente = false;
    }

    private void EditarRecibo(ReciboResponse recibo)
    {
        reciboEditando = recibo;
        numeroRecibo = recibo.NumeroRecibo;
        dniClienteRecibo = recibo.DniCliente;
        importeReciboTexto = recibo.Importe.ToString();
        fechaEmision = recibo.FechaEmision.Date;
        
        LimpiarErroresRecibo();
        mensajeRecibo = $"Editando recibo {recibo.NumeroRecibo}";
        esErrorRecibo = false;
    }

