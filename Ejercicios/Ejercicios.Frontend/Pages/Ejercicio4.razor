    // ===== MÉTODOS DE GESTIÓN DE RECIBOS =====
    
    private async Task GuardarRecibo()
    {
        try
        {
            isProcessingRecibo = true;
            LimpiarErroresRecibo();
            mensajeRecibo = "";

            var hayErrores = false;

            // Validar número de recibo
            if (string.IsNullOrWhiteSpace(numeroRecibo))
            {
                errorNumeroRecibo = true;
                hayErrores = true;
            }

            // Validar DNI del cliente
            if (string.IsNullOrWhiteSpace(dniClienteRecibo))
            {
                errorDniRecibo = true;
                mensajeErrorDniRecibo = "El DNI del cliente es obligatorio";
                hayErrores = true;
            }
            else if (!ValidarFormatoDni(dniClienteRecibo))
            {
                errorDniRecibo = true;
                mensajeErrorDniRecibo = "El DNI debe tener exactamente 8 dígitos seguidos de una letra (ej: 12345678A)";
                hayErrores = true;
            }

            // Validar importe
            if (string.IsNullOrWhiteSpace(importeReciboTexto))
            {
                errorImporteRecibo = true;
                mensajeErrorImporte = "El importe es obligatorio";
                hayErrores = true;
            }
            else if (!decimal.TryParse(importeReciboTexto.Trim(), out decimal importe) || importe <= 0)
            {
                errorImporteRecibo = true;
                mensajeErrorImporte = "El importe debe ser un número mayor que 0";
                hayErrores = true;
            }

            if (hayErrores)
            {
                mensajeRecibo = "Corrija los errores en el formulario";
                esErrorRecibo = true;
                return;
            }

            var importeDecimal = decimal.Parse(importeReciboTexto.Trim());
            var dniNormalizado = dniClienteRecibo.Trim().ToUpper();

            if (reciboEditando == null)
            {
                // Crear nuevo recibo
                var request = new ReciboRequest
                {
                    NumeroRecibo = numeroRecibo.Trim(),
                    DniCliente = dniNormalizado,
                    Importe = importeDecimal,
                    FechaEmision = fechaEmision
                };

                var response = await Http.PostAsJsonAsync("api/recibo", request);
                
                if (response.IsSuccessStatusCode)
                {
                    var reciboCreado = await response.Content.ReadFromJsonAsync<ReciboResponse>();
                    mensajeRecibo = $"Recibo {reciboCreado!.NumeroRecibo} creado correctamente";
                    esErrorRecibo = false;
                    LimpiarFormularioRecibo();
                    await CargarTodosLosRecibos();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    mensajeRecibo = $"Error al crear recibo: {error}";
                    esErrorRecibo = true;
                }
            }
            else
            {
                // Actualizar recibo existente
                var request = new ReciboUpdateRequest
                {
                    Importe = importeDecimal,
                    FechaEmision = fechaEmision
                };

                var response = await Http.PutAsJsonAsync($"api/recibo/{reciboEditando.NumeroRecibo}", request);
                
                if (response.IsSuccessStatusCode)
                {
                    mensajeRecibo = $"Recibo {reciboEditando.NumeroRecibo} actualizado correctamente";
                    esErrorRecibo = false;
                    reciboEditando = null;
                    LimpiarFormularioRecibo();
                    await CargarTodosLosRecibos();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    mensajeRecibo = $"Error al actualizar recibo: {error}";
                    esErrorRecibo = true;
                }
            }
        }
        catch (Exception ex)
        {
            mensajeRecibo = $"Error de conexión: {ex.Message}";
            esErrorRecibo = true;
        }
        finally
        {
            isProcessingRecibo = false;
        }
    }

