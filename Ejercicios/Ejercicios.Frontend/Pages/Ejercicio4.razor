        mensajeRecibo = "Edición cancelada";
        esErrorRecibo = false;
    }

    private async Task VerRecibosCliente(string dni)
    {
        try
        {
            dniBusquedaRecibo = dni;
            await BuscarRecibosPorCliente();
            
            // Cambiar a la pestaña de recibos usando Blazor nativo
            activeTab = "recibos";
            
            mensajeRecibo = $"Mostrando recibos del cliente {dni}. " + mensajeRecibo;
            esErrorRecibo = false;
        }
        catch (Exception ex)
        {
            mensajeRecibo = $"Error: {ex.Message}";
            esErrorRecibo = true;
        }
    }

    // Métodos para probar el cambio de pestañas
    private void LimpiarFormularioCliente()
    {
        dniCliente = "";
        nombreCliente = "";
        apellidosCliente = "";
        tipoClienteSeleccionado = "";
        cuotaMaximaTexto = "";
        dniBusqueda = "";
        
        LimpiarErroresCliente();
    }

    private void LimpiarFormularioRecibo()
    {
        numeroRecibo = "";
        dniClienteRecibo = "";
        importeReciboTexto = "";
        fechaEmision = DateTime.Today;
        dniBusquedaRecibo = "";
        
        LimpiarErroresRecibo();
    }

    private void LimpiarErroresCliente()
    {
        errorDniCliente = false;
        errorNombreCliente = false;
        errorApellidosCliente = false;
        errorTipoCliente = false;
        errorCuotaMaxima = false;
        errorDniBusqueda = false;
        
        mensajeErrorDni = "";
        mensajeErrorCuota = "";
        mensajeErrorDniBusqueda = "";
    }

    private void LimpiarErroresRecibo()
    {
        errorNumeroRecibo = false;
        errorDniRecibo = false;
        errorImporteRecibo = false;
        errorDniBusquedaRecibo = false;
        
        mensajeErrorDniRecibo = "";
        mensajeErrorImporte = "";
        mensajeErrorDniBusquedaRecibo = "";
    }

    // Cargar datos iniciales
    protected override async Task OnInitializedAsync()
    {
        await CargarTodosLosClientes();
        await CargarTodosLosRecibos();
    }

