@page "/profile"
@attribute [Authorize]
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<Profile> Logger
@inject IJSRuntime JSRuntime

<PageTitle>Mi Perfil - Ejercicios</PageTitle>

<div class="container mt-4">
    <!-- Encabezado del perfil -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white">
                <div class="card-body text-center py-5">
                    <div class="avatar-circle mx-auto mb-3">
                        <i class="bi bi-person-circle display-1"></i>
                    </div>
                    <h2 class="mb-1">@AuthService.Usuario?.NombreCompleto</h2>
                    <p class="lead mb-0">@@@AuthService.Usuario?.NombreUsuario</p>
                    <small class="opacity-75">
                        Miembro desde @(AuthService.Usuario?.FechaRegistro.ToString("dd/MM/yyyy"))
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Pestañas -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "info" ? "active" : "")" 
                    @onclick="@(() => ChangeTab("info"))" type="button">
                <i class="bi bi-person-lines-fill"></i> Información
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "edit" ? "active" : "")" 
                    @onclick="@(() => ChangeTab("edit"))" type="button">
                <i class="bi bi-pencil"></i> Editar Perfil
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "password" ? "active" : "")" 
                    @onclick="@(() => ChangeTab("password"))" type="button">
                <i class="bi bi-key"></i> Cambiar Contraseña
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "security" ? "active" : "")" 
                    @onclick="@(() => ChangeTab("security"))" type="button">
                <i class="bi bi-shield-check"></i> Seguridad
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "exercises" ? "active" : "")" 
                    @onclick="@(() => ChangeTab("exercises"))" type="button">
                <i class="bi bi-star"></i> Ejercicios
            </button>
        </li>
    </ul>

    <!-- Contenido de pestañas -->
    @if (activeTab == "info")
    {
        <!-- Información del usuario (sin cambios) -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-person-lines-fill text-primary"></i> Información Personal
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-4">
                                <strong>Nombre de usuario:</strong>
                            </div>
                            <div class="col-sm-8">
                                @AuthService.Usuario?.NombreUsuario
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4">
                                <strong>Email:</strong>
                            </div>
                            <div class="col-sm-8">
                                @AuthService.Usuario?.Email
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-4">
                                <strong>Nombre completo:</strong>
                            </div>
                            <div class="col-sm-8">
                                @AuthService.Usuario?.NombreCompleto
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <strong>Fecha de registro:</strong>
                            </div>
                            <div class="col-sm-8">
                                @AuthService.Usuario?.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Estadísticas de uso -->
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-graph-up text-success"></i> Estadísticas de Uso
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6 mb-3">
                                <div class="stat-card">
                                    <h3 class="text-primary">@diasActivo</h3>
                                    <small class="text-muted">Días activo</small>
                                </div>
                            </div>
                            <div class="col-6 mb-3">
                                <div class="stat-card">
                                    <h3 class="text-success">7</h3>
                                    <small class="text-muted">Ejercicios disponibles</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTab == "edit")
    {
        <!-- Editar perfil (sin cambios de la versión anterior) -->
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-pencil text-primary"></i> Editar Información Personal
                        </h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="updateProfileRequest" OnValidSubmit="UpdateProfile">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label">Nombre de usuario:</label>
                                <InputText @bind-Value="updateProfileRequest.NombreUsuario" 
                                          class="form-control" />
                                <ValidationMessage For="() => updateProfileRequest.NombreUsuario" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email:</label>
                                <InputText @bind-Value="updateProfileRequest.Email" 
                                          type="email" 
                                          class="form-control" />
                                <ValidationMessage For="() => updateProfileRequest.Email" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nombre completo:</label>
                                <InputText @bind-Value="updateProfileRequest.NombreCompleto" 
                                          class="form-control" />
                            </div>

                            @if (!string.IsNullOrEmpty(mensajeProfile))
                            {
                                <div class="alert @(esErrorProfile ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
                                    <i class="bi bi-@(esErrorProfile ? "exclamation-triangle" : "check-circle")"></i>
                                    @mensajeProfile
                                    <button type="button" class="btn-close" @onclick="@(() => mensajeProfile = "")"></button>
                                </div>
                            }

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button type="button" class="btn btn-secondary me-md-2" @onclick="CancelEditProfile">
                                    <i class="bi bi-x-circle"></i> Cancelar
                                </button>
                                <button type="submit" class="btn btn-primary" disabled="@isProcessingProfile">
                                    @if (isProcessingProfile)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="bi bi-check-circle"></i> Actualizar Perfil
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTab == "password")
    {
        <!-- Cambiar contraseña (sin cambios de la versión anterior) -->
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-key text-warning"></i> Cambiar Contraseña
                        </h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="changePasswordRequest" OnValidSubmit="ChangePassword">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label">Contraseña actual:</label>
                                <InputText @bind-Value="changePasswordRequest.CurrentPassword" 
                                          type="password" 
                                          class="form-control" />
                                <ValidationMessage For="() => changePasswordRequest.CurrentPassword" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nueva contraseña:</label>
                                <InputText @bind-Value="changePasswordRequest.NewPassword" 
                                          type="password" 
                                          class="form-control" />
                                <ValidationMessage For="() => changePasswordRequest.NewPassword" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Confirmar nueva contraseña:</label>
                                <InputText @bind-Value="changePasswordRequest.ConfirmNewPassword" 
                                          type="password" 
                                          class="form-control" />
                                <ValidationMessage For="() => changePasswordRequest.ConfirmNewPassword" />
                            </div>

                            @if (!string.IsNullOrEmpty(mensajePassword))
                            {
                                <div class="alert @(esErrorPassword ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
                                    <i class="bi bi-@(esErrorPassword ? "exclamation-triangle" : "check-circle")"></i>
                                    @mensajePassword
                                    <button type="button" class="btn-close" @onclick="@(() => mensajePassword = "")"></button>
                                </div>
                            }

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button type="button" class="btn btn-secondary me-md-2" @onclick="CancelChangePassword">
                                    <i class="bi bi-x-circle"></i> Cancelar
                                </button>
                                <button type="submit" class="btn btn-warning" disabled="@isProcessingPassword">
                                    @if (isProcessingPassword)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="bi bi-key"></i> Cambiar Contraseña
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTab == "security")
    {
        <!-- NUEVA PESTAÑA: Configuración de seguridad y 2FA -->
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-shield-check text-info"></i> Configuración de Seguridad
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Información sobre 2FA -->
                        <div class="alert alert-info mb-4">
                            <h6 class="alert-heading">
                                <i class="bi bi-info-circle"></i> Autenticación de Dos Factores (2FA)
                            </h6>
                            <p class="mb-2">
                                La autenticación de dos factores añade una capa adicional de seguridad a tu cuenta.
                            </p>
                            <ul class="mb-0 small">
                                <li>Recibirás un código de 6 dígitos por email cada vez que inicies sesión</li>
                                <li>El código expira en 10 minutos</li>
                                <li>Protege tu cuenta incluso si alguien conoce tu contraseña</li>
                            </ul>
                        </div>

                        <!-- Estado actual de 2FA -->
                        <div class="card mb-4 @(twoFactorEnabled ? "border-success" : "border-secondary")">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h6>
                                            <i class="bi bi-@(twoFactorEnabled ? "shield-check" : "shield-x")"></i>
                                            Autenticación de Dos Factores
                                        </h6>
                                        <p class="mb-0 small text-muted">
                                            Estado: 
                                            <strong class="@(twoFactorEnabled ? "text-success" : "text-secondary")">
                                                @(twoFactorEnabled ? "Habilitada" : "Deshabilitada")
                                            </strong>
                                        </p>
                                    </div>
                                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                        <div class="form-check form-switch d-flex justify-content-md-end">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   role="switch" 
                                                   id="toggle2FA"
                                                   checked="@twoFactorEnabled"
                                                   @onchange="ToggleTwoFactor"
                                                   disabled="@isProcessing2FA"
                                                   style="width: 3rem; height: 1.5rem; cursor: pointer;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(mensaje2FA))
                        {
                            <div class="alert @(esError2FA ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
                                <i class="bi bi-@(esError2FA ? "exclamation-triangle" : "check-circle")"></i>
                                @mensaje2FA
                                <button type="button" class="btn-close" @onclick="@(() => mensaje2FA = "")"></button>
                            </div>
                        }

                        <!-- Instrucciones de uso -->
                        @if (twoFactorEnabled)
                        {
                            <div class="card border-success">
                                <div class="card-header bg-success text-white">
                                    <h6 class="mb-0">
                                        <i class="bi bi-check-circle"></i> 2FA Habilitada
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <p><strong>Tu cuenta está protegida con 2FA.</strong></p>
                                    <p class="mb-2">En tu próximo inicio de sesión:</p>
                                    <ol class="small mb-0">
                                        <li>Ingresa tu email y contraseña como siempre</li>
                                        <li>Recibirás un código de 6 dígitos en tu email: <strong>@AuthService.Usuario?.Email</strong></li>
                                        <li>Introduce el código para completar el inicio de sesión</li>
                                        <li>El código es válido por 10 minutos</li>
                                    </ol>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTab == "exercises")
    {
        <!-- Ejercicios disponibles (sin cambios) -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-star-fill text-warning"></i> Ejercicios Disponibles
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var ejercicio in ejerciciosDisponibles)
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body text-center">
                                            <i class="@ejercicio.Icono @ejercicio.ColorClase display-6 mb-2"></i>
                                            <h6 class="card-title">@ejercicio.Titulo</h6>
                                            <p class="card-text small text-muted">@ejercicio.Descripcion</p>
                                            <a href="@ejercicio.Url" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-arrow-right"></i> Ir al ejercicio
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Zona de peligro (sin cambios) -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle-fill"></i> Zona de Peligro
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h6 class="text-danger">Eliminar cuenta permanentemente</h6>
                            <p class="text-muted mb-0">
                                Una vez eliminada tu cuenta, no podrás recuperar tus datos. 
                                Esta acción es irreversible.
                            </p>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <button class="btn btn-outline-danger" @onclick="ConfirmDeleteAccount" disabled="@isProcessingDelete">
                                @if (isProcessingDelete)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-trash"></i> Eliminar Cuenta
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Botones de navegación -->
    <div class="row mt-4 mb-4">
        <div class="col-12 text-center">
            <a href="/home" class="btn btn-primary me-3">
                <i class="bi bi-house"></i> Volver al Inicio
            </a>
            <button class="btn btn-outline-secondary" @onclick="CerrarSesion">
                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
            </button>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 120px;
        height: 120px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-card {
        padding: 1rem;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.02);
        transition: background-color 0.2s ease;
    }

    .stat-card h3 {
        margin-bottom: 0.25rem;
        font-weight: bold;
    }

    .stat-card:hover {
        background: rgba(0, 0, 0, 0.05);
    }

    .form-check-input:checked {
        background-color: #28a745;
        border-color: #28a745;
    }
</style>

@code {
    private int diasActivo = 0;
    private string activeTab = "info";

    // Variables para editar perfil
    private UpdateProfileRequest updateProfileRequest = new UpdateProfileRequest();
    private bool isProcessingProfile = false;
    private string mensajeProfile = "";
    private bool esErrorProfile = false;

    // Variables para cambiar contraseña
    private ChangePasswordRequest changePasswordRequest = new ChangePasswordRequest();
    private bool isProcessingPassword = false;
    private string mensajePassword = "";
    private bool esErrorPassword = false;

    // Variables para 2FA
    private bool twoFactorEnabled = false;
    private bool isProcessing2FA = false;
    private string mensaje2FA = "";
    private bool esError2FA = false;

    // Variables para eliminar cuenta
    private bool isProcessingDelete = false;

    private List<EjercicioInfo> ejerciciosDisponibles = new List<EjercicioInfo>
    {
        new EjercicioInfo { Titulo = "Ejercicio 1", Descripcion = "Calculadora matemática", Url = "/ejercicio1", Icono = "bi bi-calculator", ColorClase = "text-primary" },
        new EjercicioInfo { Titulo = "Ejercicio 2", Descripcion = "Procesamiento de texto", Url = "/ejercicio2", Icono = "bi bi-fonts", ColorClase = "text-success" },
        new EjercicioInfo { Titulo = "Ejercicio 3", Descripcion = "Operaciones con fechas", Url = "/ejercicio3", Icono = "bi bi-calendar3", ColorClase = "text-info" },
        new EjercicioInfo { Titulo = "Ejercicio 4", Descripcion = "CRUD de clientes", Url = "/ejercicio4", Icono = "bi bi-database", ColorClase = "text-warning" },
        new EjercicioInfo { Titulo = "Ejercicio 5", Descripcion = "Implementación de clases", Url = "/ejercicio5", Icono = "bi bi-gear", ColorClase = "text-secondary" },
        new EjercicioInfo { Titulo = "Ejercicio 6", Descripcion = "Formas geométricas", Url = "/ejercicio6", Icono = "bi bi-shapes", ColorClase = "text-dark" },
        new EjercicioInfo { Titulo = "Ejercicio 7", Descripcion = "Números de Kaprekar", Url = "/ejercicio7", Icono = "bi bi-infinity", ColorClase = "text-danger" }
    };

    protected override void OnInitialized()
    {
        Logger.LogInformation("Inicializando página de perfil de usuario: {Usuario}", 
            AuthService.Usuario?.NombreUsuario);

        // Calcular días activo
        if (AuthService.Usuario?.FechaRegistro != null)
        {
            diasActivo = (DateTime.Now - AuthService.Usuario.FechaRegistro).Days + 1;
        }

        // Inicializar formulario de edición con datos actuales
        if (AuthService.Usuario != null)
        {
            var userId = AuthService.GetUserId();
            if (userId.HasValue)
            {
                updateProfileRequest = new UpdateProfileRequest
                {
                    UserId = userId.Value,
                    NombreUsuario = AuthService.Usuario.NombreUsuario,
                    Email = AuthService.Usuario.Email,
                    NombreCompleto = AuthService.Usuario.NombreCompleto
                };

                changePasswordRequest = new ChangePasswordRequest
                {
                    UserId = userId.Value
                };

                // TODO: Cargar estado de 2FA desde el servidor
                // Por ahora asumimos false, pero deberías hacer una petición al API
                twoFactorEnabled = false;
            }
        }
    }

    private void ChangeTab(string tab)
    {
        activeTab = tab;
        
        // Limpiar mensajes al cambiar de pestaña
        mensajeProfile = "";
        mensajePassword = "";
        mensaje2FA = "";
    }

    private async Task ToggleTwoFactor(ChangeEventArgs e)
    {
        try
        {
            isProcessing2FA = true;
            mensaje2FA = "";
            esError2FA = false;

            var userId = AuthService.GetUserId();
            if (!userId.HasValue)
            {
                mensaje2FA = "Error: No se pudo obtener el ID de usuario";
                esError2FA = true;
                return;
            }

            var newValue = (bool)(e.Value ?? false);

            Logger.LogInformation("Cambiando estado de 2FA para usuario: {Usuario}, Nuevo estado: {Estado}", 
                AuthService.Usuario?.NombreUsuario, newValue);

            var (success, message) = await AuthService.Toggle2FAAsync(userId.Value, newValue);

            if (success)
            {
                twoFactorEnabled = newValue;
                mensaje2FA = message;
                esError2FA = false;
                
                Logger.LogInformation("Estado de 2FA cambiado exitosamente para usuario: {Usuario}", 
                    AuthService.Usuario?.NombreUsuario);
            }
            else
            {
                mensaje2FA = message;
                esError2FA = true;
                Logger.LogWarning("Error al cambiar estado de 2FA: {Error}", message);
            }
        }
        catch (Exception ex)
        {
            mensaje2FA = $"Error: {ex.Message}";
            esError2FA = true;
            Logger.LogError(ex, "Error al cambiar estado de 2FA");
        }
        finally
        {
            isProcessing2FA = false;
        }
    }

    // ... resto de métodos sin cambios (UpdateProfile, ChangePassword, DeleteAccount, etc.)
    
    private async Task UpdateProfile()
    {
        try
        {
            isProcessingProfile = true;
            mensajeProfile = "";
            esErrorProfile = false;

            Logger.LogInformation("Actualizando perfil para usuario: {Usuario}", updateProfileRequest.NombreUsuario);

            var (success, message) = await AuthService.UpdateProfileAsync(updateProfileRequest);

            if (success)
            {
                mensajeProfile = message;
                esErrorProfile = false;
                
                Logger.LogInformation("Perfil actualizado exitosamente para usuario: {Usuario}", 
                    updateProfileRequest.NombreUsuario);

                await Task.Delay(1500);
                activeTab = "info";
                mensajeProfile = "";
            }
            else
            {
                mensajeProfile = message;
                esErrorProfile = true;
                Logger.LogWarning("Error al actualizar perfil: {Error}", message);
            }
        }
        catch (Exception ex)
        {
            mensajeProfile = $"Error: {ex.Message}";
            esErrorProfile = true;
            Logger.LogError(ex, "Error al actualizar perfil");
        }
        finally
        {
            isProcessingProfile = false;
        }
    }

    private async Task ChangePassword()
    {
        try
        {
            isProcessingPassword = true;
            mensajePassword = "";
            esErrorPassword = false;

            Logger.LogInformation("Cambiando contraseña para usuario: {Usuario}", AuthService.Usuario?.NombreUsuario);

            var (success, message) = await AuthService.ChangePasswordAsync(changePasswordRequest);

            if (success)
            {
                mensajePassword = message;
                esErrorPassword = false;
                
                Logger.LogInformation("Contraseña actualizada exitosamente para usuario: {Usuario}", 
                    AuthService.Usuario?.NombreUsuario);

                changePasswordRequest.CurrentPassword = "";
                changePasswordRequest.NewPassword = "";
                changePasswordRequest.ConfirmNewPassword = "";

                await Task.Delay(1500);
                activeTab = "info";
                mensajePassword = "";
            }
            else
            {
                mensajePassword = message;
                esErrorPassword = true;
                Logger.LogWarning("Error al cambiar contraseña: {Error}", message);
            }
        }
        catch (Exception ex)
        {
            mensajePassword = $"Error: {ex.Message}";
            esErrorPassword = true;
            Logger.LogError(ex, "Error al cambiar contraseña");
        }
        finally
        {
            isProcessingPassword = false;
        }
    }

    private async Task ConfirmDeleteAccount()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            "¿Estás seguro de que quieres eliminar tu cuenta permanentemente? Esta acción no se puede deshacer.");

        if (confirmed)
        {
            await DeleteAccount();
        }
    }

    private async Task DeleteAccount()
    {
        try
        {
            isProcessingDelete = true;
            
            var userId = AuthService.GetUserId();
            if (!userId.HasValue)
            {
                Logger.LogError("No se pudo obtener el ID del usuario para eliminar la cuenta");
                return;
            }

            Logger.LogWarning("Eliminando cuenta para usuario: {Usuario}", AuthService.Usuario?.NombreUsuario);

            var (success, message) = await AuthService.DeleteAccountAsync(userId.Value);

            if (success)
            {
                Logger.LogWarning("Cuenta eliminada exitosamente para usuario: {Usuario}", AuthService.Usuario?.NombreUsuario);
                
                await JSRuntime.InvokeVoidAsync("alert", "Tu cuenta ha sido eliminada correctamente.");
                Navigation.NavigateTo("/auth");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Error al eliminar la cuenta: {message}");
                Logger.LogError("Error al eliminar cuenta: {Error}", message);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
            Logger.LogError(ex, "Error al eliminar cuenta");
        }
        finally
        {
            isProcessingDelete = false;
        }
    }

    private void CancelEditProfile()
    {
        if (AuthService.Usuario != null)
        {
            updateProfileRequest.NombreUsuario = AuthService.Usuario.NombreUsuario;
            updateProfileRequest.Email = AuthService.Usuario.Email;
            updateProfileRequest.NombreCompleto = AuthService.Usuario.NombreCompleto;
        }
        
        mensajeProfile = "";
        activeTab = "info";
    }

    private void CancelChangePassword()
    {
        changePasswordRequest.CurrentPassword = "";
        changePasswordRequest.NewPassword = "";
        changePasswordRequest.ConfirmNewPassword = "";
        
        mensajePassword = "";
        activeTab = "info";
    }

    private async Task CerrarSesion()
    {
        Logger.LogInformation("Usuario {Usuario} cerró sesión desde perfil", 
            AuthService.Usuario?.NombreUsuario);
        
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/auth");
    }

