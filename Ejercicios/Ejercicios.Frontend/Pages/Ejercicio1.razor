@page "/ejercicio1"
@inject HttpClient Http
@inject ILogger<Ejercicio1> Logger

<PageTitle>Ejercicio 1 - Operaciones con números</PageTitle>

<h1>Calculadora de operaciones matemáticas</h1>

<p>Introduce dos cantidades y el número de decimales para el redondeo.</p>

<div class="container">
    <div class="row mb-3">
        <div class="col-md-4">
            <label for="cantidad1" class="form-label">Primera cantidad:</label>
            <input type="text" class="form-control @(errorCantidad1 ? "is-invalid" : "")" 
                   id="cantidad1" @bind="cantidad1Text" placeholder="10.5" />
            @if (errorCantidad1)
            {
                <div class="invalid-feedback">
                    Debe introducir un número real válido
                </div>
            }
        </div>
        <div class="col-md-4">
            <label for="cantidad2" class="form-label">Segunda cantidad:</label>
            <input type="text" class="form-control @(errorCantidad2 ? "is-invalid" : "")" 
                   id="cantidad2" @bind="cantidad2Text" placeholder="3.2" />
            @if (errorCantidad2)
            {
                <div class="invalid-feedback">
                    Debe introducir un número real válido
                </div>
            }
        </div>
        <div class="col-md-4">
            <label for="decimales" class="form-label">Número de decimales:</label>
            <input type="text" class="form-control @(errorDecimales ? "is-invalid" : "")" 
                   id="decimales" @bind="numDecimalesText" placeholder="2" />
            @if (errorDecimales)
            {
                <div class="invalid-feedback">
                    Debe ser un número entero entre 0 y 10
                </div>
            }
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-12">
            <button class="btn btn-primary me-2" @onclick="CalcularOperaciones" disabled="@isCalculating">
                @if (isCalculating)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <text> Calculando...</text>
                }
                else
                {
                    <text>Calcular operaciones</text>
                }
            </button>
            <button class="btn btn-secondary" @onclick="LimpiarDatos" disabled="@isCalculating">
                Limpiar
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @errorMessage
        </div>
    }

    @if (mostrarResultados && resultado != null)
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3>Resultados</h3>
                    </div>
                    <div class="card-body">
                        <table class="table table-striped">
                            <tbody>
                                <tr>
                                    <td><strong>Suma:</strong></td>
                                    <td>@cantidad1Calculada + @cantidad2Calculada = @resultado.Suma</td>
                                </tr>
                                <tr>
                                    <td><strong>Resta:</strong></td>
                                    <td>@cantidad1Calculada - @cantidad2Calculada = @resultado.Resta</td>
                                </tr>
                                <tr>
                                    <td><strong>Multiplicación:</strong></td>
                                    <td>@cantidad1Calculada * @cantidad2Calculada = @resultado.Multiplicacion</td>
                                </tr>
                                <tr>
                                    <td><strong>División:</strong></td>
                                    <td>@cantidad1Calculada / @cantidad2Calculada = @resultado.Division</td>
                                </tr>
                                <tr>
                                    <td><strong>Módulo:</strong></td>
                                    <td>@cantidad1Calculada % @cantidad2Calculada = @resultado.Modulo</td>
                                </tr>
                                <tr>
                                    <td><strong>Comparación:</strong></td>
                                    <td>@cantidad1Calculada @resultado.Comparacion @cantidad2Calculada</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Variables para las cantidades como texto (para capturar letras)
    private string cantidad1Text = "";
    private string cantidad2Text = "";
    private string numDecimalesText = "2";

    // Variables para valores parseados
    private double cantidad1Calculada = 0;
    private double cantidad2Calculada = 0;
    private int numDecimalesCalculados = 2;

    // Variables de estado de error por campo
    private bool errorCantidad1 = false;
    private bool errorCantidad2 = false;
    private bool errorDecimales = false;

    // Variables para mostrar los resultados
    private bool mostrarResultados = false;
    private bool isCalculating = false;
    private string errorMessage = "";
    private OperacionResult? resultado;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Inicializando componente Ejercicio1 (Calculadora de operaciones matemáticas)");
    }

    private async Task CalcularOperaciones()
    {
        try
        {
            Logger.LogInformation("Iniciando cálculo de operaciones matemáticas desde el frontend");

            isCalculating = true;
            errorMessage = "";
            mostrarResultados = false;
            
            // Resetear errores individuales
            errorCantidad1 = false;
            errorCantidad2 = false;
            errorDecimales = false;

            // Validar primera cantidad
            if (string.IsNullOrWhiteSpace(cantidad1Text))
            {
                errorCantidad1 = true;
                errorMessage = "La primera cantidad es obligatoria.";
                Logger.LogWarning("Validación fallida: primera cantidad vacía");
                return;
            }

            if (!double.TryParse(cantidad1Text.Trim(), out double cantidad1))
            {
                errorCantidad1 = true;
                errorMessage = $"La primera cantidad '{cantidad1Text}' no es un número válido. Por favor, introduzca un número real.";
                Logger.LogWarning("Validación fallida: primera cantidad inválida - {Cantidad1Text}", cantidad1Text);
                return;
            }

            // Validar segunda cantidad
            if (string.IsNullOrWhiteSpace(cantidad2Text))
            {
                errorCantidad2 = true;
                errorMessage = "La segunda cantidad es obligatoria.";
                Logger.LogWarning("Validación fallida: segunda cantidad vacía");
                return;
            }

            if (!double.TryParse(cantidad2Text.Trim(), out double cantidad2))
            {
                errorCantidad2 = true;
                errorMessage = $"La segunda cantidad '{cantidad2Text}' no es un número válido. Por favor, introduzca un número real.";
                Logger.LogWarning("Validación fallida: segunda cantidad inválida - {Cantidad2Text}", cantidad2Text);
                return;
            }

            // Validar decimales
            if (string.IsNullOrWhiteSpace(numDecimalesText))
            {
                errorDecimales = true;
                errorMessage = "El número de decimales es obligatorio.";
                Logger.LogWarning("Validación fallida: número de decimales vacío");
                return;
            }

            if (!int.TryParse(numDecimalesText.Trim(), out int numDecimales))
            {
                errorDecimales = true;
                errorMessage = $"El número de decimales '{numDecimalesText}' no es un número entero válido.";
                Logger.LogWarning("Validación fallida: número de decimales inválido - {NumDecimalesText}", numDecimalesText);
                return;
            }

            if (numDecimales < 0 || numDecimales > 10)
            {
                errorDecimales = true;
                errorMessage = "El número de decimales debe estar entre 0 y 10.";
                Logger.LogWarning("Validación fallida: número de decimales fuera de rango - {NumDecimales}", numDecimales);
                return;
            }

            // Si llegamos aquí, todas las validaciones pasaron
            cantidad1Calculada = cantidad1;
            cantidad2Calculada = cantidad2;
            numDecimalesCalculados = numDecimales;

            Logger.LogDebug("Validaciones completadas. Enviando solicitud al API: {Cantidad1}, {Cantidad2}, {NumDecimales} decimales", 
                cantidad1, cantidad2, numDecimales);

            var request = new OperacionRequest
            {
                Cantidad1 = cantidad1Calculada,
                Cantidad2 = cantidad2Calculada,
                NumDecimales = numDecimalesCalculados
            };

            var response = await Http.PostAsJsonAsync("api/calculadora/calcular", request);

            if (response.IsSuccessStatusCode)
            {
                resultado = await response.Content.ReadFromJsonAsync<OperacionResult>();
                mostrarResultados = true;

                Logger.LogInformation("Cálculo completado exitosamente. Cantidad1: {Cantidad1}, Cantidad2: {Cantidad2}, Decimales: {NumDecimales}", 
                    cantidad1, cantidad2, numDecimales);

                if (cantidad2 == 0)
                {
                    Logger.LogDebug("División por cero detectada en el frontend para {Cantidad1} / {Cantidad2}", cantidad1, cantidad2);
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al procesar la solicitud: {response.StatusCode}";
                Logger.LogError("Error en la respuesta del API: {StatusCode} - {ErrorContent}", response.StatusCode, errorContent);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión: {ex.Message}";
            Logger.LogError(ex, "Error de conexión al calcular operaciones matemáticas");
        }
        finally
        {
            isCalculating = false;
            Logger.LogDebug("Finalizando proceso de cálculo de operaciones");
        }
    }

    private void LimpiarDatos()
    {
        Logger.LogDebug("Limpiando formulario de calculadora");

        // Limpiar los campos de entrada
        cantidad1Text = "";
        cantidad2Text = "";
        numDecimalesText = "2";

        // Limpiar valores calculados
        cantidad1Calculada = 0;
        cantidad2Calculada = 0;
        numDecimalesCalculados = 2;

        // Limpiar errores
        errorCantidad1 = false;
        errorCantidad2 = false;
        errorDecimales = false;

        // Limpiar los resultados y mensajes
        mostrarResultados = false;
        errorMessage = "";
        resultado = null;
    }

    // Modelos para el frontend
    public class OperacionRequest
    {
        public double Cantidad1 { get; set; }
        public double Cantidad2 { get; set; }
        public int NumDecimales { get; set; }
    }

    public class OperacionResult
    {
        public string Suma { get; set; } = "";
        public string Resta { get; set; } = "";
        public string Multiplicacion { get; set; } = "";
        public string Division { get; set; } = "";
        public string Modulo { get; set; } = "";
        public string Comparacion { get; set; } = "";
    }
}