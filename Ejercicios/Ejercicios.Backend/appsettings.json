{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=ejercicios_db;Username=ejercicios_user;Password=ejercicios_pass"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "ApplicationName": "Ejercicios.Backend"
    }
  },
  "Email": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": "2525",
    "Username": "8d3f72a0d8318e",
    "Password": "da662500933f76",
    "From": "noreply@ejercicios.com"
  },
  "AllowedHosts": "*"
}